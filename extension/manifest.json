{
  "manifest_version": 3,
  "name": "Controle de Ponto CGOF",
  "version": "1.0.0",
  "description": "Registra entrada e saída do expediente direto no Chronos Ponto (CGOF).",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bater Ponto",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://controle-ponto-cgof.vercel.app/*",
    "https://yhwiertvbkeirvlieuag.supabase.co/*"
  ]
}
